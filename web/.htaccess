RewriteEngine On
RewriteBase /

ErrorDocument 404 /404.html

# 1. Existing physical files and directories are served directly
# (protects static HTML pages like /custom-adapter-sdk/, documentation folders, assets, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Tag and category archive pages: attach noindex header and return 410 Gone
<IfModule mod_headers.c>
  RewriteRule ^(tag|category)/ - [E=NOINDEX:1]
  Header set X-Robots-Tag "noindex, follow" env=NOINDEX
</IfModule>
RewriteRule ^tag/.+/?$ - [G,L]
RewriteRule ^category/.+/?$ - [G,L]

# 3. Old blog post permalinks (WordPress date-based format) - retired in migration
RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/.+/?$ - [G,L]

# 4. Old WordPress query parameters (e.g. /?p=123, /?page_id=45)
RewriteCond %{QUERY_STRING} ^(p|page_id)=[0-9]+$
RewriteRule ^$ - [G,L]

# 5. Old static pages moved to their current routes (301 Permanent Redirects)
RewriteRule ^contact/?$ /contact-us [R=301,L]
RewriteRule ^news-press/?$ /newsroom [R=301,L]
RewriteRule ^customized-monetization-solutions/?$ /monetization [R=301,L]
RewriteRule ^services/?$ /solutions [R=301,L]
RewriteRule ^product/?$ /monetization/ctv [R=301,L]
RewriteRule ^swift-playout/?$ /monetization/ctv [R=301,L]
RewriteRule ^about(-us)?/?$ /company [R=301,L]

# 6. Canonical URLs: Strip trailing slashes on virtual routes only (NEVER on real directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 7. Pre-rendered pages from tool/generate_seo_pages.mjs:
# /company -> prerendered/company.html, /blogs/9/slug -> prerendered/blogs/9/slug.html.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^prerendered/ - [R=404,L]
RewriteCond %{DOCUMENT_ROOT}/prerendered/$1.html -f
RewriteRule ^(.+)$ prerendered/$1.html [L]

# 8. Root homepage
RewriteRule ^$ index.html [L]

# 9. Known app routes without a pre-rendered file boot the Flutter app
RewriteCond %{DOCUMENT_ROOT}/prerendered/app-shell.html -f
RewriteRule ^((company|careers|contact-us|monetization|monetization/(ctv|web|in-app|game)|solutions|media-hub|blogs|newsroom|gallery|privacy-policy|test)|(blogs|casestudy|gallery)/.+)$ prerendered/app-shell.html [L]
RewriteRule ^(company|careers|contact-us|monetization|monetization/(ctv|web|in-app|game)|solutions|media-hub|blogs|newsroom|gallery|privacy-policy|test)$ index.html [L]
RewriteRule ^(blogs|casestudy|gallery)/.+$ index.html [L]

# 10. Anything else is a real 404 (was a 200 with homepage -> Soft 404)
RewriteRule ^ - [R=404,L]
